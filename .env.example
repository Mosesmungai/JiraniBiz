# Firebase Admin SDK - server-side only; never use NEXT_PUBLIC_ prefixes.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-client-email
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key
FIREBASE_STORAGE_BUCKET=replace-with-storage-bucket-name

# Session signing - use a unique random secret per environment.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Password-reset mail - server-side only.
APP_BASE_URL=https://your-deployment.example.invalid
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional M-Pesa payment instructions; these values are displayed to users.
MPESA_PAYBILL=
MPESA_TILL_NUMBER=

# Optional local SQLite migration path; scripts only.
JIRANIBIZ_SQLITE_PATH=src/data/jiranibiz.db
