# Firebase / Firestore production database
FIREBASE_PROJECT_ID=jiranibiz
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-service-account-private-key

# Required in production for session signing. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Required for private business-photo uploads and signed image URLs.
FIREBASE_STORAGE_BUCKET=replace-with-your-firebase-storage-bucket

# Optional until M-Pesa collection is configured. If both are blank, the app
# will not show payment instructions; do not collect payments manually.
MPESA_PAYBILL=
MPESA_TILL_NUMBER=
